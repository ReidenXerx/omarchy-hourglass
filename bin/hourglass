#!/usr/bin/python3 -I
"""Hourglass's helper.

  hourglass add                 read one line on stdin, a JSON array of stretches and pick-ups, and keep them
                                (one line, because the shell's Process.write() cannot close stdin)
  hourglass report [--limits T] print the day, the week and the limits as one bounded JSON answer
  hourglass weekly              print this week's summary once, the first time it is asked for after
                                Sunday 20:00, and nothing after that until next week
  hourglass probe PID           print what runs in the terminal window whose process is PID
  hourglass forget-details      take every detail label out of the history, keeping the times
  hourglass told KEY            remember that the notice KEY was given today, so a restart does not repeat it
  hourglass serve               the Plasma edition's recorder: a session-bus service the widget talks to
  hourglass install-service     set the recorder up as a user service that starts with the desktop (Plasma)
  hourglass remove-service      take that service away again
"""
from __future__ import annotations

import argparse
import json
import pathlib
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "app"))
import history  # noqa: E402
import terminal  # noqa: E402

STDIN_MAX = 256 * 1024
def add() -> int:
    raw = sys.stdin.buffer.readline(STDIN_MAX + 1)
    if len(raw) > STDIN_MAX:
        print("hourglass: too much input", file=sys.stderr)
        return 1
    try:
        batch = json.loads(raw.decode("utf-8", "replace") or "[]")
    except ValueError:
        print("hourglass: input is not JSON", file=sys.stderr)
        return 1
    if not isinstance(batch, list):
        return 1
    history.keep(batch, time.time())
    return 0


def report(limits_text: str) -> int:
    print(json.dumps(history.build_report(limits_text, time.time()), separators=(",", ":"), ensure_ascii=True))
    return 0


def weekly() -> int:
    line = history.weekly_due(time.time())
    if line:
        print(line)
    return 0


def forget_details() -> int:
    history.forget_details()
    return 0


def told(key: str) -> int:
    return 0 if history.told(key) else 1


def probe(pid: str) -> int:
    if not pid.isdigit() or not 0 < int(pid) < 1 << 22:
        return 1
    print(terminal.describe(int(pid)))
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="hourglass")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("add")
    rep = sub.add_parser("report")
    rep.add_argument("--limits", default="")
    sub.add_parser("weekly")
    pr = sub.add_parser("probe")
    pr.add_argument("pid")
    sub.add_parser("forget-details")
    sub.add_parser("serve")
    sub.add_parser("install-service")
    sub.add_parser("remove-service")
    tl = sub.add_parser("told")
    tl.add_argument("key")
    args = parser.parse_args(argv)
    if args.cmd == "serve":
        import service
        return service.run()
    if args.cmd in ("install-service", "remove-service"):
        import unit
        return unit.install() if args.cmd == "install-service" else unit.remove()
    if args.cmd == "told":
        return told(args.key[:120])
    if args.cmd == "probe":
        return probe(args.pid)
    if args.cmd == "forget-details":
        return forget_details()
    if args.cmd == "add":
        return add()
    if args.cmd == "report":
        return report(args.limits[:2000])
    return weekly()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
