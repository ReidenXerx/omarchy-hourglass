#!/usr/bin/python3 -I
"""Hourglass's helper.

  hourglass add                 read one line on stdin, a JSON array of stretches and pick-ups, and keep them
                                (one line, because the shell's Process.write() cannot close stdin)
  hourglass report [--limits T] print the day, the week and the limits as one bounded JSON answer
  hourglass weekly              print this week's summary once, the first time it is asked for after
                                Sunday 20:00, and nothing after that until next week
  hourglass probe PID           print what runs in the terminal window whose process is PID
  hourglass forget-details      take every detail label out of the history, keeping the times
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import pathlib
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "app"))
import apps  # noqa: E402
import core  # noqa: E402
import store  # noqa: E402
import terminal  # noqa: E402

STDIN_MAX = 256 * 1024
KEEP_DAYS = 30
SUMMARY_DAYS = 40      # how far back a missing day summary is filled in


def add() -> int:
    now = time.time()
    raw = sys.stdin.buffer.readline(STDIN_MAX + 1)
    if len(raw) > STDIN_MAX:
        print("hourglass: too much input", file=sys.stderr)
        return 1
    try:
        batch = json.loads(raw.decode("utf-8", "replace") or "[]")
    except ValueError:
        print("hourglass: input is not JSON", file=sys.stderr)
        return 1
    if not isinstance(batch, list):
        return 1
    for item in batch[:5000]:
        r = core.read_stretch(item, now)
        if r is None:
            continue
        if "p" in r:
            store.append("days", store.day_name(r["p"]), r)
            continue
        # A stretch across midnight is kept as two, one in each day's file.
        s, e = r["s"], r["e"]
        while s < e:
            next_midnight = int(dt.datetime.combine(dt.date.fromtimestamp(s) + dt.timedelta(days=1), dt.time()).timestamp())
            cut = min(e, next_midnight)
            part = {"a": r["a"], "s": s, "e": cut}
            if r.get("d"):
                part["d"] = r["d"]
            store.append("days", store.day_name(s), part)
            s = cut
    summarise_past(now)
    store.prune("days", KEEP_DAYS, dt.date.fromtimestamp(now))
    store.prune("totals", 800, dt.date.fromtimestamp(now))
    return 0


def day_records(day: dt.date, now: float) -> list[dict]:
    rows = store.read_lines("days", day.isoformat() + ".jsonl")
    return [r for r in (core.read_stretch(x, now) for x in rows) if r]


def all_totals(now: float) -> list[dict]:
    year = dt.date.fromtimestamp(now).year
    rows = store.read_lines("totals", f"{year - 1}.jsonl", 2 * 1024 * 1024) + \
        store.read_lines("totals", f"{year}.jsonl", 2 * 1024 * 1024)
    out = {}
    for r in rows:
        t = core.read_totals(r)
        if t:
            out[t["d"]] = t
    return list(out.values())


def summarise_past(now: float) -> None:
    """Keep a year of days: summarise each finished day that has no summary yet."""
    done = {t["d"] for t in all_totals(now)}
    today = dt.date.fromtimestamp(now)
    resolve = apps.Resolver()
    for k in range(SUMMARY_DAYS, 0, -1):
        day = today - dt.timedelta(days=k)
        if day.isoformat() in done:
            continue
        records = day_records(day, now)
        if not records:
            continue
        start = int(dt.datetime.combine(day, dt.time()).timestamp())
        summary = core.summarise_day(records, start, start + 86400 + 3600, resolve)
        store.append("totals", f"{day.year}.jsonl", core.day_totals(summary, day.isoformat()))


def report(limits_text: str) -> int:
    now = time.time()
    today = dt.date.fromtimestamp(now)
    start = int(dt.datetime.combine(today, dt.time()).timestamp())
    resolve = apps.Resolver()
    day = core.summarise_day(day_records(today, now), start, int(now) + 1, resolve)
    totals = all_totals(now)
    avg = core.average(totals, today.isoformat())
    w = core.week(totals, day, today.isoformat())
    for a in w["apps"]:
        info = resolve(a["app"])
        a["name"], a["category"] = info["name"], info["category"]
    for a in day["apps"]:
        a.pop("raw", None)      # only the significant details leave the helper
    limits = core.limit_use(core.parse_limits(limits_text), day)
    for x in limits:
        x["name"] = resolve(x["key"])["name"] if x["kind"] == "app" else x["key"]
    out = {"now": int(now), "today": day, "average": round(avg) if avg is not None else None, "week": w,
           "limits": limits, "categories": core.CATEGORIES}
    print(json.dumps(out, separators=(",", ":"), ensure_ascii=True))
    return 0


def weekly() -> int:
    now = time.time()
    d = dt.datetime.fromtimestamp(now)
    if d.isoweekday() != 7 or d.hour < 20:
        return 0
    week_id = f"{d.isocalendar()[0]}-W{d.isocalendar()[1]:02d}"
    sent = {r.get("w") for r in store.read_lines("state", "weekly.jsonl", 64 * 1024) if isinstance(r, dict)}
    if week_id in sent:
        return 0
    today = d.date()
    start = int(dt.datetime.combine(today, dt.time()).timestamp())
    day = core.summarise_day(day_records(today, now), start, int(now) + 1, apps.Resolver())
    w = core.week(all_totals(now), day, today.isoformat())
    if w["total"] <= 0:
        return 0
    store.append("state", "weekly.jsonl", {"w": week_id})
    print(core.weekly_text(w))
    return 0


def forget_details() -> int:
    for sub in ("days", "totals"):
        for name in store.names(sub):
            rows = store.read_lines(sub, name)
            if any(isinstance(r, dict) and ("d" in r or "det" in r) for r in rows):
                store.rewrite(sub, name, [core.without_details(r) for r in rows])
    return 0


def probe(pid: str) -> int:
    if not pid.isdigit() or not 0 < int(pid) < 1 << 22:
        return 1
    print(terminal.describe(int(pid)))
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="hourglass")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("add")
    rep = sub.add_parser("report")
    rep.add_argument("--limits", default="")
    sub.add_parser("weekly")
    pr = sub.add_parser("probe")
    pr.add_argument("pid")
    sub.add_parser("forget-details")
    args = parser.parse_args(argv)
    if args.cmd == "probe":
        return probe(args.pid)
    if args.cmd == "forget-details":
        return forget_details()
    if args.cmd == "add":
        return add()
    if args.cmd == "report":
        return report(args.limits[:2000])
    return weekly()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
